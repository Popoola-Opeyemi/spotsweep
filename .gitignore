# Rust build output
/target/
**/*.rs.bk

# Release artifacts and checksums (built by scripts/build-release.sh)
/dist/

# Runtime state (never commit)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite
*.db

# Generated exports, inventories, logs
exports/
inventory-*.txt
*.log
launchd.*.log

# Generated LaunchAgent plists contain personal absolute paths.
# The template is committed; generated plists are not.
launchagent/*.plist
!launchagent/*.plist.template

# Local configuration and secrets
config/*.local.toml
.env
.env.*
*.pem
*.key

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
.vscode/
*.swp
